{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": false
  },
  "include": ["src"],
  "exclude": [
    "src/comp/MongoDB_test.tsx",
    "src/comp/Redis_test.tsx",
    "src/comp/SqlQuery_test.tsx",
    "src/comp/SqlTableView_test.tsx",
    "src/comp/QueryResp_test.tsx"
  ],

  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
