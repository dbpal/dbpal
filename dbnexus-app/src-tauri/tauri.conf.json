{
  "app": {
    "security": {
      "capabilities": ["main-capability", "desktop-capability"],
      "csp": null
    },
    "windows": [
      {
        "title": "dbpal"
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "dmg", "msi", "rpm", "appimage"]
  },
  "identifier": "site.dbpal.dev",
  "productName": "dbpal",
  "version": "1.3.2"
}
