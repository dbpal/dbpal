{
  "app": {
    "security": {
      "capabilities": ["main-capability", "desktop-capability"],
      "csp": null
    },
    "windows": [
      {
        "title": "dbpal"
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "dmg", "msi"]
  },
  "identifier": "site.dbpal.dev",
  "plugins": {
    "typegen": {
      "excludePatterns": null,
      "force": false,
      "includePatterns": null,
      "includePrivate": false,
      "outputPath": "./src/generated",
      "projectPath": ["../../dbnexus-db/src/data_source.rs", "./src-tauri"],
      "typeMappings": null,
      "validationLibrary": "none",
      "verbose": true,
      "visualizeDeps": true
    }
  },
  "productName": "dbpal",
  "version": "1.3.1"
}
