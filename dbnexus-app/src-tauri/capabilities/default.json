{
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "dialog:default",
    "shell:default",
    "store:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://redis.io"
        }
      ]
    },
    "opener:allow-default-urls",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-rename",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:read-dirs",
    "core:window:allow-destroy",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-set-webview-zoom",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": ["**/*"]
    },
    "opener:default",
    "os:default",
    "process:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
